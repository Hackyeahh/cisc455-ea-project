diff --git a/test_coin_robot.py b/test_coin_robot.py
new file mode 100644
index 0000000..d008fc9
--- /dev/null
+++ b/test_coin_robot.py
@@ -0,0 +1,61 @@
+"""Sanity checks for the coin robot. Run with `python test_coin_robot.py` (about 15 s) or with pytest.
+
+1. The oracle matches a brute-force search over every subset and order of coins.
+2. No robot ever collects more coins than the oracle, so regret is never negative.
+3. A robot never walks more steps than its budget.
+"""
+import itertools
+
+import numpy as np
+
+from coin_robot import (adjacency, bfs, decode, oracle, random_coin_maze, run_episode, usable_random_mazes)
+
+
+def brute_force(maze, budget):
+    grid, coins = maze
+    n = grid.shape[0]
+    adj, blocked, goal = adjacency(n), grid.ravel().tolist(), n * n - 1
+    pts = [0] + [int(c) for c in coins]
+    dist = {p: bfs(p, blocked, adj) for p in pts}
+    best = 0
+    for r in range(len(coins) + 1):
+        for order in itertools.permutations(range(1, len(coins) + 1), r):
+            at, total = 0, 0
+            for k in order:
+                total += dist[pts[at]][pts[k]]
+                at = k
+            if total + dist[pts[at]][goal] <= budget:
+                best = max(best, r)
+    return best
+
+
+def test_oracle_matches_brute_force():
+    rng = np.random.default_rng(1)
+    checked = 0
+    for budget in (60, 90, 140):
+        for _ in range(20):
+            maze = random_coin_maze(rng, 21, 160, k=5)      # 5 coins keeps the brute force fast
+            info = oracle(maze, budget)
+            if info["violation"]:
+                continue
+            checked += 1
+            assert info["score"] == brute_force(maze, budget)
+    assert checked >= 30
+
+
+def test_robot_never_beats_oracle_and_respects_budget():
+    rng = np.random.default_rng(2)
+    budget = 85
+    mazes = usable_random_mazes(12, budget, seed=5)
+    for _ in range(15):
+        genome = rng.random(5)
+        for maze in mazes:
+            run = run_episode(maze[0], maze[1], decode(genome), budget)
+            assert run["score"] <= oracle(maze, budget)["score"]
+            assert run["steps"] <= budget
+
+
+if __name__ == "__main__":
+    test_oracle_matches_brute_force()
+    test_robot_never_beats_oracle_and_respects_budget()
+    print("all checks passed")
