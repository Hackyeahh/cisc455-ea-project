@@ -0,0 +1,166 @@
+"""Evolve coin-collecting robots, mazes, or both at once (competitive coevolution).
+
+Three runners, all built from the same small pieces:
+
+    train_robot       robots evolve against a fixed set of mazes          (evolution strategy)
+    run_maze_vs_fixed mazes evolve against one fixed robot                 (the original project's idea)
+    run_coevolution   robots and mazes evolve against each other           (with a hall of fame)
+
+Maze fitness comes in two flavours:
+
+    "score"   minimise the robot's coin score. A maze can "win" by being brutal for every
+              robot: a long, walled-up route with dead ends beats any explorer.
+    "regret"  maximise (best score any robot in the pool gets) - (this robot's score), the idea
+              behind PAIRED. A maze nobody can handle earns nothing. The maze has to exploit a
+              weakness of *this* robot's policy while a differently-behaving robot copes.
+
+The oracle (a robot that knows the map) is only used to reject unusable mazes and as a ceiling
+for reporting. Regret against the oracle would mostly measure hidden information, which no
+policy can fix, and it saturates immediately.
+"""
+import numpy as np
+
+from coin_robot import (N_COINS, make_child, oracle, random_coin_maze, random_robots, robot_score,
+                        usable_random_mazes, vary_robots)
+
+RATE = 3 / 441
+
+
+# ----------------------------------------------------------------------------- fitness
+def mean_score(genome, mazes, budget):
+    return float(np.mean([robot_score(genome, m, budget) for m in mazes]))
+
+
+def maze_fitness(maze, robots, budget, objective="regret", antagonists=()):
+    """Higher = better maze. Unusable mazes (no path, or path longer than the budget) rank last.
+
+    `robots` are the robots the maze is trying to beat. `antagonists` are extra robots that only show
+    what is achievable (they raise the regret bar but are not themselves the target).
+    """
+    info = oracle(maze, budget)
+    if info["violation"]:
+        return -N_COINS - 1.0 - info["violation"]
+    scores = [robot_score(g, maze, budget) for g in robots]
+    if objective == "score":
+        return -float(np.mean(scores))
+    best = max(scores + [robot_score(g, maze, budget) for g in antagonists])
+    return best - float(np.mean(scores))
+
+
+# ----------------------------------------------------------------------------- one generation
+def maze_generation(rng, pop, fit, fn, lam, wall_budget, rate=RATE, tournament_k=3):
+    """(mu + lambda) maze GA step. `fit=None` re-evaluates the parents (opponents may have changed)."""
+    if fit is None:
+        fit = np.array([fn(m) for m in pop])
+
+    def pick():
+        idx = rng.choice(len(pop), tournament_k, replace=False)
+        return pop[idx[np.argmax(fit[idx])]]
+
+    kids = [make_child(rng, pick(), pick(), rate, wall_budget) for _ in range(lam)]
+    merged, mfit = pop + kids, np.concatenate([fit, [fn(k) for k in kids]])
+    keep = np.argsort(-mfit, kind="stable")[: len(pop)]
+    return [merged[i] for i in keep], mfit[keep]
+
+
+def robot_generation(rng, parents, fn, lam, mu):
+    """(mu, lambda) evolution-strategy step. Comma selection suits fitness that changes every generation."""
+    kids = vary_robots(rng, parents, lam)
+    kfit = np.array([fn(k) for k in kids])
+    keep = np.argsort(-kfit, kind="stable")[:mu]
+    return [kids[i] for i in keep], kfit[keep]
+
+
+def opponents(rng, pop, fit, hof, k=5, n_current=2):
+    """The current best few plus random picks from the hall of fame (fills up from the population)."""
+    order = np.argsort(-fit, kind="stable") if fit is not None else np.arange(len(pop))
+    chosen = [pop[i] for i in order[:n_current]]
+    if hof:
+        chosen += [hof[i] for i in rng.choice(len(hof), min(k - n_current, len(hof)), replace=False)]
+    rest = [pop[i] for i in order[n_current:]]
+    while len(chosen) < k and rest:
+        chosen.append(rest.pop(int(rng.integers(len(rest)))))
+    return chosen
+
+
+# ----------------------------------------------------------------------------- runners
+def train_robot(seed, mazes, budget, gens=25, mu=6, lam=18):
+    """Evolve a robot against a fixed training set with a (mu + lambda) evolution strategy."""
+    rng = np.random.default_rng(seed)
+    pop = random_robots(rng, mu + lam)
+    fit = np.array([mean_score(g, mazes, budget) for g in pop])
+    keep = np.argsort(-fit, kind="stable")[:mu]
+    pop, fit = [pop[i] for i in keep], fit[keep]
+    history = [fit[0]]
+    for _ in range(gens):
+        kids = vary_robots(rng, pop, lam)
+        kfit = np.array([mean_score(k, mazes, budget) for k in kids])
+        merged, mfit = pop + kids, np.concatenate([fit, kfit])
+        keep = np.argsort(-mfit, kind="stable")[:mu]
+        pop, fit = [merged[i] for i in keep], mfit[keep]
+        history.append(fit[0])
+    return dict(best=pop[0], history=np.array(history))
+
+
+def run_maze_vs_fixed(seed, robot, budget, objective, antagonists=(), gens=40, pop_m=24, lam_m=12,
+                      wall_budget=160, n=21):
+    """Evolve mazes against one fixed robot. Returns the final population, best first."""
+    rng = np.random.default_rng(seed)
+    pop = usable_random_mazes(pop_m, budget, seed=seed * 1000 + 17, n=n, wall_budget=wall_budget)
+    fn = lambda m: maze_fitness(m, [robot], budget, objective, antagonists)
+    fit = np.array([fn(m) for m in pop])
+    for _ in range(gens):
+        pop, fit = maze_generation(rng, pop, fit, fn, lam_m, wall_budget)
+    return dict(pop=pop, fit=fit)
+
+
+def run_coevolution(seed, budget, bench, gens=40, pop_m=24, lam_m=12, mu_r=6, lam_r=18, n_opp=5,
+                    wall_budget=160, n=21):
+    """Competitive coevolution of mazes and robots with a hall of fame for each side.
+
+    Every generation, mazes face the current best robots plus hall-of-fame robots, and robots face the
+    current best mazes plus hall-of-fame mazes. Both sides use the same opponents for all their
+    individuals in a generation, so comparisons inside a generation are fair.
+
+    `bench` = dict(mazes=[...], hard_mazes=[...], robots=[...]) is a FIXED benchmark that never
+    evolves. Each generation the champions are scored on it, which shows real progress rather than the
+    moving-target "Red Queen" effect of fitness against changing opponents. The champion robot is scored on
+    random mazes and on hard mazes (evolved elsewhere); the champion maze is scored by the regret it causes
+    the benchmark robots.
+    """
+    rng = np.random.default_rng(seed)
+    mazes = usable_random_mazes(pop_m, budget, seed=seed * 1000 + 17, n=n, wall_budget=wall_budget)
+    robots, mfit, rfit = random_robots(rng, mu_r), None, None
+    maze_hof, robot_hof, log = [], [], []
+    for gen in range(gens):
+        opp_robots = opponents(rng, robots, rfit, robot_hof, n_opp)
+        opp_mazes = opponents(rng, mazes, mfit, maze_hof, n_opp)
+        mazes, mfit = maze_generation(rng, mazes, None, lambda m: maze_fitness(m, opp_robots, budget), lam_m,
+                                      wall_budget)
+        robots, rfit = robot_generation(rng, robots, lambda g: mean_score(g, opp_mazes, budget), lam_r, mu_r)
+        maze_hof.append(mazes[0])
+        robot_hof.append(robots[0])
+        champ_maze, champ_robot = mazes[0], robots[0]
+        log.append(dict(
+            gen=gen + 1,
+            maze_regret_vs_opponents=float(mfit[0]),
+            robot_score_vs_opponents=float(rfit[0]),
+            bench_regret_of_champion_maze=maze_fitness(champ_maze, bench["robots"], budget),
+            bench_score_of_champion_robot=mean_score(champ_robot, bench["mazes"], budget),
+            bench_hard_score_of_champion_robot=mean_score(champ_robot, bench["hard_mazes"], budget),
+            champion_maze_walls=int(champ_maze[0].sum()),
+            champion_maze_oracle=oracle(champ_maze, budget)["score"],
+        ))
+    return dict(maze_hof=maze_hof, robot_hof=robot_hof, log=log, mazes=mazes, robots=robots)
+
+
+def master_tournament(robot_hof, maze_hof, budget, every=5):
+    """Coins scored by the champion robot of generation i on the champion maze of generation j.
+
+    Rows are robot generations, columns are maze generations. Moving right along a row shows whether later
+    mazes beat a fixed robot (scores fall); moving down a column shows whether later robots handle a fixed
+    maze better (scores rise). Cycling patterns mean the arms race goes in circles instead of progressing.
+    """
+    idx = list(range(every - 1, len(robot_hof), every))
+    M = np.array([[robot_score(robot_hof[i], maze_hof[j], budget) for j in idx] for i in idx], float)
+    return [i + 1 for i in idx], M
