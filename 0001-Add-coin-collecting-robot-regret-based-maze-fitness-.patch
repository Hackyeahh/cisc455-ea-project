+    curves = {k: np.array([[g[k] for g in run["log"]] for run in co], float) for k in keys}
+    ref_random = float(np.mean([mean_score(g, bench_random, BUDGET) for g in es]))
+    ref_hard = float(np.mean([mean_score(g, hard, BUDGET) for g in es]))
+    ref_hand_regret = None
+    results["coevolution"] = dict(
+        final_champion_robot_on_random_mazes=[float(c[-1]) for c in curves["bench_score_of_champion_robot"]],
+        final_champion_robot_on_hard_mazes=[float(c[-1]) for c in curves["bench_hard_score_of_champion_robot"]],
+        evolved_on_random_reference=dict(random=ref_random, hard=ref_hard),
+        final_champion_maze_regret=[float(c[-1]) for c in curves["bench_regret_of_champion_maze"]],
+        final_champion_maze_walls=[float(c[-1]) for c in curves["champion_maze_walls"]])
+
+    fig, axes = plt.subplots(1, 3, figsize=(14.5, 4.2))
+    a1, a2, a3 = axes
+    band_plot(a1, curves["bench_score_of_champion_robot"], BLUE, "Random mazes")
+    band_plot(a1, curves["bench_hard_score_of_champion_robot"], ORANGE, "Hard mazes")
+    a1.axhline(ref_random, color=BLUE, lw=1, ls="--"); a1.axhline(ref_hard, color=ORANGE, lw=1, ls="--")
+    a1.set(xlabel="Generation", ylabel="Coins collected", ylim=(0, 8), xlim=(0, gens_co * 1.35),
+           title="Champion robot on a fixed benchmark")
+    a1.annotate("dashed: robots evolved on random mazes only", (0, 7.6), xytext=(4, 0), textcoords="offset points",
+                fontsize=8, color=INK2)
+    band_plot(a2, curves["bench_regret_of_champion_maze"], BLUE, "Regret")
+    a2.set(xlabel="Generation", ylabel="Regret vs benchmark robots (coins)", xlim=(0, gens_co * 1.3),
+           title="Champion maze on a fixed benchmark")
+    band_plot(a3, curves["champion_maze_walls"], BLUE, "Walls")
+    a3.set(xlabel="Generation", ylabel="Walls in the champion maze", xlim=(0, gens_co * 1.3), ylim=(0, 170),
+           title="Wall count of the champion maze")
+    runs_txt = f"mean over {n_co} runs, band = min–max" if n_co > 1 else "single run"
+    fig.suptitle(f"Coevolution of mazes and robots ({runs_txt})", y=1.0, fontsize=11)
+    fig.tight_layout(); fig.savefig(OUT / "fig9_coevolution.png", dpi=150); plt.close(fig)
+
+    every = max(1, gens_co // 8)
+    gens_axis, M = master_tournament(co[0]["robot_hof"], co[0]["maze_hof"], BUDGET, every)
+    fig, ax = plt.subplots(figsize=(6.4, 5.4))
+    heatmap(ax, M, gens_axis, gens_axis, vmax=8, fmt="{:.0f}")
+    ax.set(xlabel="Maze champion from generation", ylabel="Robot champion from generation",
+           title="Coins scored: every robot champion vs every maze champion (run 0)")
+    ax.title.set_fontsize(9.5)
+    fig.tight_layout(); fig.savefig(OUT / "fig10_master_tournament.png", dpi=150); plt.close(fig)
+    results["master_tournament"] = dict(generations=gens_axis, coins=M.tolist())
+
+    # --- 4. Cross-test: who handles mazes built against someone else? ------------------------------
+    brutal = [m for pop in e2["score"] for m in pop[:3]]
+    coevolved = [run["robot_hof"][-1] for run in co]
+    rows = {"Hand-written": [HAND], "Evolved on\nrandom mazes": fresh, "Coevolved\n(final champion)": coevolved}
+    cols = {"Random\nmazes": test, "Brutal mazes\n(min score vs robot A)": brutal,
+            "Regret mazes\n(vs robot A)": hard}
+    C = np.array([[np.mean([mean_score(g, ms, BUDGET) for g in gs]) for ms in cols.values()] for gs in rows.values()])
+    results["cross_test_mean_coins"] = {r.replace("\n", " "): {c.replace("\n", " "): float(C[i, j])
+                                                              for j, c in enumerate(cols)}
+                                        for i, r in enumerate(rows)}
+    fig, ax = plt.subplots(figsize=(7.6, 3.8))
+    heatmap(ax, C, list(cols), list(rows), vmax=8)
+    ax.set_title("Mean coins; the mazes in columns 2–3 were built against robot A, not these robots", fontsize=9.5)
+    fig.tight_layout(); fig.savefig(OUT / "fig11_cross_test.png", dpi=150); plt.close(fig)
+    log("cross-test done")
+
+    (OUT / "results_coin.json").write_text(json.dumps(results, indent=2))
+    log(f"Wrote {OUT}")
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--quick", action="store_true")
+    main(p.parse_args().quick)
